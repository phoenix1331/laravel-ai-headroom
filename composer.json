{
    "name": "phoenix1331/laravel-ai-headroom",
    "description": "Token counting and context limits for the Laravel AI SDK.",
    "keywords": [
        "laravel",
        "ai",
        "llm",
        "headroom",
        "tokens",
        "token-counting",
        "context-window",
        "cost",
        "anthropic",
        "openai",
        "gemini",
        "laravel-ai-sdk"
    ],
    "homepage": "https://phoenix1331.github.io/laravel-ai-headroom",
    "license": "MIT",
    "authors": [
        {
            "name": "Darren",
            "email": "darren@phoenix1331.co.uk",
            "homepage": "https://phoenix1331.co.uk"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "laravel/ai": "^1.2"
    },
    "autoload": {
        "psr-4": {
            "Phoenix1331\\AiHeadroom\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phoenix1331\\AiHeadroom\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Phoenix1331\\AiHeadroom\\AiHeadroomServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest",
        "test:coverage": "pest --coverage --min=90",
        "test:accuracy": "pest --testsuite=Accuracy"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require-dev": {
        "laravel/pint": "^1.32",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0|^5.0",
        "pestphp/pest-plugin-laravel": "^4.0|^5.0"
    }
}
