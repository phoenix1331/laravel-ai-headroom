{
    "name": "phoenix1331/laravel-ai-headroom",
    "description": "Token counting and context limits for the Laravel AI SDK.",
    "keywords": [
        "laravel",
        "ai",
        "llm",
        "headroom",
        "tokens",
        "token-counting",
        "context-window",
        "cost",
        "anthropic",
        "openai",
        "gemini",
        "laravel-ai-sdk"
    ],
    "homepage": "https://phoenix1331.github.io/laravel-ai-headroom",
    "license": "MIT",
    "authors": [
        {
            "name": "Darren Williams",
            "homepage": "https://github.com/phoenix1331"
        }
    ],
    "support": {
        "issues": "https://github.com/phoenix1331/laravel-ai-headroom/issues",
        "source": "https://github.com/phoenix1331/laravel-ai-headroom"
    },
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "laravel/ai": "^1.2",
        "yethee/tiktoken": "^1.1"
    },
    "autoload": {
        "psr-4": {
            "Phoenix1331\\AiHeadroom\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phoenix1331\\AiHeadroom\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Phoenix1331\\AiHeadroom\\AiHeadroomServiceProvider"
            ],
            "aliases": {
                "Headroom": "Phoenix1331\\AiHeadroom\\Facades\\Headroom"
            }
        }
    },
    "scripts": {
        "test": "pest",
        "test:coverage": "pest --coverage --min=90",
        "test:accuracy": "pest --testsuite=Accuracy",
        "lint": "pint",
        "lint:test": "pint --test",
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.32",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.2|^5.0",
        "pestphp/pest-plugin-laravel": "^4.0|^5.0"
    }
}
